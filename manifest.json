{
    "manifest_version": 3,
    "name": "SmartMark",
    "version": "1.0",
    "description": "스마트 개인화 북마크 확장 프로그램",
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": [
      "activeTab",    
      "bookmarks",
      "scripting",
      "storage",
      "contextMenus",
      "tabs",
      "webRequest",
      "offscreen",
      "notifications"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "web_accessible_resources": [
      {
        "resources": [
          "textEmbedder.js", 
          "utils/tfidf.js", 
          "search-methods.js", 
          "offscreen-bert.js", 
          "offscreen.html", 
          "offscreen.js",
          "ort.min.js",
          "ort-wasm.wasm",
          "ort-wasm-simd.wasm",
          "ort-wasm-threaded.wasm",
          "ort-wasm-simd-threaded.wasm"
        ],
        "matches": ["<all_urls>"]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://tfhub.dev https://storage.googleapis.com https://*.googleapis.com https://*.cloudfunctions.net https://generativelanguage.googleapis.com"
    }
  }